# ── Deployment SPN (used ONLY to run the provisioning pipeline itself - ──
# ── ARM deployments, creating the per-agent App Registration, SharePoint  ──
# ── provisioning. Its access to each customer tenant is deleted at the   ──
# ── end of every successful deployment - see teardown_service.py.        ──
# ── It is NOT the agent's runtime identity anymore; that's a fresh       ──
# ── App Registration created per-customer by app_registration_service.py ──
DEPLOYMENT_SPN_CLIENT_ID=
DEPLOYMENT_SPN_SECRET=
DEPLOYMENT_SPN_TENANT_ID=547b64a7-e66e-48df-a146-3e898cbcb60f
# Object ID of the deployment SPN's Service Principal in Skysecure's OWN
# home tenant (not per-customer) - kept for reference only.
DEPLOYMENT_SPN_HOME_OBJECT_ID=

# ── Source ACR (Skysecure's own registry holding built agent images). ──
# ── Every deployment imports FROM here INTO a fresh customer-owned ACR - ──
# ── see acr_service.py. The deployment SPN needs Contributor (or a       ──
# ── scoped custom role) on this ACR in Skysecure's own subscription.     ──
SOURCE_ACR_NAME=skysecureacr
SOURCE_ACR_RESOURCE_GROUP=
SOURCE_ACR_SUBSCRIPTION_ID=

# ── Default region for new deployments ──
DEFAULT_LOCATION=southindia

# ── Path to the ARM template files (mounted/copied alongside the app) ──
ARM_TEMPLATES_DIR=./arm-templates
